# Local development only. Replace these placeholders before exposing a deployment.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=local-postgres-password
MONITOR_DB_PASSWORD=local-monitor-password
NOTIFIER_DB_PASSWORD=local-notifier-password
MONITOR_HTTP_ADDR=:8080
MONITOR_DATABASE_URL=postgres://monitor:local-monitor-password@localhost:5433/monitor_db?sslmode=disable
MONITOR_PUBLIC_URL=http://localhost:8080
MONITOR_CHECK_WORKERS=20
MONITOR_SCHEDULER_INTERVAL=5s
MONITOR_CHECK_RETENTION_DAYS=30
NOTIFIER_HTTP_ADDR=:8081
NOTIFIER_DATABASE_URL=postgres://notifier:local-notifier-password@localhost:5433/notifier_db?sslmode=disable
NOTIFIER_DELIVERY_WORKERS=2
KAFKA_BROKERS=localhost:19092
KAFKA_TLS=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM='SitePulse <sitepulse@example.test>'
SMTP_TLS_MODE=none
